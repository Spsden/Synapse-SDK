{
  "$schema": "../../schemas/manifest.schema.json",
  "manifestVersion": 2,
  "id": "com.synapse.notion",
  "name": "Notion",
  "version": "1.1.0",
  "description": "Capture notes and discover databases in Notion through its MCP server.",
  "author": "Synapse",
  "minSynapseVersion": "1.0.0",
  "security": {
    "allowedDomains": [],
    "permissions": ["mcp", "config"]
  },
  "mcp": {
    "servers": [
      {
        "id": "notion",
        "endpoint": "https://mcp.notion.com/mcp",
        "authentication": "oauth"
      }
    ]
  },
  "config": [
    {
      "key": "notion_parent_id",
      "label": "Notion Parent ID",
      "type": "text",
      "description": "Optional page, database, or data source ID used as the parent."
    },
    {
      "key": "notion_parent_type",
      "label": "Parent Type",
      "type": "select",
      "default": "auto",
      "options": ["auto", "page", "database", "data_source"]
    }
  ],
  "actions": [
    {
      "id": "add_to_notion",
      "description": "Create a Notion page from shared text.",
      "triggers": ["add_to_notion", "save_to_notion"],
      "inputSchema": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Title for the new Notion page."
          },
          "content": {
            "type": "string",
            "description": "Markdown-compatible page content."
          },
          "databaseId": {
            "type": "string",
            "description": "Optional Notion database ID to create the page in."
          },
          "parentPageId": {
            "type": "string",
            "description": "Optional Notion parent page ID to create the page under."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "tool": { "type": "string" },
          "title": { "type": "string" },
          "parent": { "type": "string" },
          "result": {}
        }
      },
      "requirements": [
        {
          "kind": "mcp",
          "serverId": "notion",
          "allow": {
            "tools": ["notion-create-pages"]
          }
        }
      ],
      "platforms": ["ios", "android", "macos", "windows", "linux"]
    },
    {
      "id": "search_notion",
      "description": "Search for databases and pages in the user's Notion workspace.",
      "triggers": ["search_notion", "list_notion_databases"],
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Optional search term to filter databases or pages by title."
          },
          "filter": {
            "type": "string",
            "description": "Optional filter: 'database' to list only databases, or 'page' for pages.",
            "enum": ["database", "page"]
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": "string" },
          "filter": { "type": "string" },
          "count": { "type": "integer" },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": { "type": "string" },
                "title": { "type": "string" },
                "type": { "type": "string" },
                "url": { "type": "string" }
              }
            }
          }
        }
      },
      "requirements": [
        {
          "kind": "mcp",
          "serverId": "notion",
          "allow": {
            "tools": ["notion-search"]
          }
        }
      ],
      "platforms": ["ios", "android", "macos", "windows", "linux"]
    }
  ],
  "categories": ["productivity"],
  "keywords": ["notion", "notes", "mcp", "database"]
}
